# Smart-Retail Shelf Sensor Network - Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_PATH=./smart_retail.db

# Device Authentication Token for Physical Hardware Sensors (ESP32)
# Hardware sensors must send this token in the 'X-Sensor-Key' header
HARDWARE_SENSOR_SECRET=smart_retail_esp32_secret_token_2026

# Sensor Network Timing (seconds)
DEFAULT_OFFLINE_TIMEOUT_SEC=15
DEFAULT_REPORTING_INTERVAL_SEC=5
